---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sezione from '../../components/Sezione.astro';
import { macchinePubblicate } from '../../lib/contenuti';

export async function getStaticPaths() {
  const macchine = await macchinePubblicate();
  return macchine.map((m) => ({ params: { slug: m.id }, props: { macchina: m } }));
}

const { macchina } = Astro.props;
const { Content } = await render(macchina);
---
<Base titolo={macchina.data.nome} descrizione={macchina.data.cosaFa} attiva="Macchine">
  <Sezione
    occhiello="Macchina"
    titolo={macchina.data.nome}
    titoloPrincipale={true}
    intro={macchina.data.cosaFa}
  >
    {macchina.data.video && (
      <p class="bottoni">
        <a class="btn btn-secondario" href={macchina.data.video} target="_blank" rel="noopener noreferrer">
          Guarda come lavora<span aria-hidden="true"> ↗</span><span class="sr-solo"> (si apre in una nuova scheda)</span>
        </a>
      </p>
    )}
    <div class="card blocco">
      <h3>A chi serve</h3>
      <p class="tenue">{macchina.data.aChiServe}</p>
    </div>
    <article class="testo"><Content /></article>
    <p class="cta"><a href="/parliamone" class="btn btn-primario">Ne voglio una così</a></p>
  </Sezione>
</Base>
