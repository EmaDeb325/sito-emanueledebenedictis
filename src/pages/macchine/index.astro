---
import Base from '../../layouts/Base.astro';
import Sezione from '../../components/Sezione.astro';
import CardMacchina from '../../components/CardMacchina.astro';
import { macchinePubblicate } from '../../lib/contenuti';

const macchine = await macchinePubblicate();
---
<Base
  titolo="Macchine · sistemi di AI che si vedono funzionare"
  descrizione="Gli automatismi che costruisco: cosa fanno, a chi servono, e il video di come lavorano davvero."
  attiva="Macchine"
>
  <Sezione
    occhiello="Le macchine"
    titolo="Sistemi che si vedono funzionare"
    titoloPrincipale={true}
    intro="Non presentazioni: cose accese. Ognuna è un pezzo di Lucia che puoi avere anche tu."
  >
    {macchine.length === 0 ? (
      <p class="attesa">Le prime macchine arrivano a breve.</p>
    ) : (
      <div class="griglia griglia-3">{macchine.map((m) => <CardMacchina macchina={m} />)}</div>
    )}
  </Sezione>
</Base>
