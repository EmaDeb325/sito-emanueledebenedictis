---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sezione from '../../components/Sezione.astro';
import { ideePubblicate } from '../../lib/contenuti';

export async function getStaticPaths() {
  const pezzi = await ideePubblicate();
  return pezzi.map((p) => ({ params: { slug: p.id }, props: { pezzo: p } }));
}

const { pezzo } = Astro.props;
const { Content } = await render(pezzo);
const declinazioni = [
  { etichetta: 'Guarda il video', href: pezzo.data.youtube },
  { etichetta: 'Guarda il reel', href: pezzo.data.reel },
  { etichetta: 'Leggi su LinkedIn', href: pezzo.data.linkedin },
].filter((d) => d.href);
---
<Base titolo={pezzo.data.titolo} descrizione={pezzo.data.sommario} attiva="Idee">
  <Sezione
    occhiello={pezzo.data.data.toLocaleDateString('it-IT')}
    titolo={pezzo.data.titolo}
    titoloPrincipale={true}
  >
    <article class="testo"><Content /></article>
    {declinazioni.length > 0 && (
      <p class="bottoni">
        {declinazioni.map((d) => (
          <a class="btn btn-secondario" href={d.href} target="_blank" rel="noopener noreferrer">
            {d.etichetta}<span aria-hidden="true"> ↗</span><span class="sr-solo"> (si apre in una nuova scheda)</span>
          </a>
        ))}
      </p>
    )}
  </Sezione>
</Base>
