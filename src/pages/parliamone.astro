---
import Base from '../layouts/Base.astro';
import Sezione from '../components/Sezione.astro';
---
<Base
  titolo="Parliamone · Emanuele De Benedictis"
  descrizione="Raccontami a che punto sei: ti dico con franchezza se e come posso esserti utile."
>
  <Sezione
    titolo="Parliamone mezz'ora."
    titoloPrincipale={true}
    intro="Mi racconti a che punto sei, io ti dico con franchezza se e come posso essere utile. Se non è il caso te lo dico, e ti indico cosa farei al tuo posto."
  >
    <form
      name="call"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/grazie"
      class="card modulo blocco"
    >
      <input type="hidden" name="bot-field" />

      <div class="campo">
        <label for="nome">Nome e cognome</label>
        <input type="text" id="nome" name="nome" autocomplete="name" required />
      </div>

      <div class="campo">
        <label for="azienda">Azienda</label>
        <input type="text" id="azienda" name="azienda" autocomplete="organization" required />
      </div>

      <div class="campo">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>

      <div class="campo">
        <label for="telefono">Telefono <span class="tenue">(facoltativo)</span></label>
        <input type="tel" id="telefono" name="telefono" autocomplete="tel" />
      </div>

      <div class="campo">
        <label for="attivita">Di cosa si occupa la tua azienda e quante persone siete?</label>
        <textarea id="attivita" name="attivita" rows="3" required></textarea>
      </div>

      <div class="campo">
        <label for="chi-porta-i-clienti">
          Oggi chi porta i clienti: tu in prima persona, qualcuno del team, o delle campagne?
        </label>
        <textarea id="chi-porta-i-clienti" name="chi-porta-i-clienti" rows="3" required></textarea>
      </div>

      <div class="campo">
        <label for="obiettivo-90-giorni">
          Cosa vorresti che funzionasse senza di te entro 90 giorni?
        </label>
        <textarea id="obiettivo-90-giorni" name="obiettivo-90-giorni" rows="3" required></textarea>
      </div>

      <button type="submit" class="btn btn-primario">Invia la richiesta</button>

      <p class="tenue nota-privacy">
        Quello che scrivi serve solo a risponderti: non finisce in nessuna lista e non lo cedo a
        nessuno.
      </p>
    </form>
  </Sezione>

  <style>
    .modulo {
      max-width: 560px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .campo { display: flex; flex-direction: column; gap: 8px; }
    .campo label { font-size: 0.92rem; font-weight: 600; }
    .campo input,
    .campo textarea {
      width: 100%;
      padding: 14px 16px;
      border-radius: 10px;
      border: 1px solid var(--bordo);
      background: var(--bg);
      color: var(--testo);
      font: inherit;
      font-size: 1rem;
    }
    .campo textarea { resize: vertical; min-height: 100px; }
    .campo input:focus,
    .campo textarea:focus {
      outline: none;
      border-color: var(--accento);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.3);
    }
    .modulo button {
      align-self: flex-start;
      border: none;
      cursor: pointer;
      font: inherit;
      margin-top: 4px;
    }
    .nota-privacy { margin-top: -6px; font-size: 0.88rem; }
    @media (max-width: 560px) {
      .modulo button { align-self: stretch; justify-content: center; }
    }
  </style>
</Base>
