---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sezione from '../../components/Sezione.astro';
import CardCaso from '../../components/CardCaso.astro';

const casi = (await getCollection('casi', ({ data }) => !data.draft))
  .sort((a, b) => a.data.ordine - b.data.ordine);
---
<Base
  titolo="Casi · lavori veri, raccontati per categoria"
  descrizione="Situazioni reali di piccole e medie imprese: cosa abbiamo costruito, cosa è cambiato, cosa è rimasto in casa loro."
  attiva="Casi"
>
  <Sezione
    occhiello="Casi"
    titolo="Aziende vere, lavori veri"
    intro="Racconto le situazioni per categoria di attività, senza nomi. Dove il risultato non è ancora misurato lo dico, e spiego cosa è stato consegnato."
  >
    <div class="griglia griglia-3">{casi.map((c) => <CardCaso caso={c} />)}</div>
  </Sezione>
</Base>
