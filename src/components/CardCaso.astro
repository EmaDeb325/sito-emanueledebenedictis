---
import type { CollectionEntry } from 'astro:content';

interface Props { caso: CollectionEntry<'casi'>; }
const { caso } = Astro.props;
---
<a class="card" href={`/casi/${caso.id}`}>
  {caso.data.stato === 'in-corso' && <span class="etichetta">In corso</span>}
  <h3>{caso.data.categoria}</h3>
  <p class="tenue">{caso.data.situazione}</p>
</a>
