---
import type { CollectionEntry } from 'astro:content';
import { ideePubblicate } from '../lib/contenuti';

interface Props { quanti?: number; messaggioSeVuoto?: boolean; }
const { quanti = 3, messaggioSeVuoto = true } = Astro.props;

const pezzi = await ideePubblicate(quanti);

const canali = (d: CollectionEntry<'idee'>['data']) =>
  [
    { etichetta: 'Articolo', href: null },
    { etichetta: 'Video', href: d.youtube },
    { etichetta: 'Reel', href: d.reel },
    { etichetta: 'LinkedIn', href: d.linkedin },
  ].filter((c) => c.href !== undefined);
---
{pezzi.length === 0 ? (
  messaggioSeVuoto && <p class="attesa">Le prime pubblicazioni arrivano a breve.</p>
) : (
  <div class="griglia griglia-3">
    {pezzi.map((p) => (
      <a class="card" href={`/idee/${p.id}`}>
        <h3>{p.data.titolo}</h3>
        <p class="tenue">{p.data.sommario}</p>
        <p class="canali">
          {canali(p.data).map((c) => <span>{c.etichetta}</span>)}
        </p>
      </a>
    ))}
  </div>
)}
<style>
  .canali { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .canali span {
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--accento); border: 1px solid var(--bordo); border-radius: 999px; padding: 4px 10px;
  }
</style>
