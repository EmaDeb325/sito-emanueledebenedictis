---
import type { CollectionEntry } from 'astro:content';

interface Props { macchina: CollectionEntry<'macchine'>; }
const { macchina } = Astro.props;
---
<a class="card" href={`/macchine/${macchina.id}`}>
  <h3>{macchina.data.nome}</h3>
  <p class="tenue">{macchina.data.cosaFa}</p>
  {macchina.data.video && <span class="etichetta coda">Con video</span>}
</a>
